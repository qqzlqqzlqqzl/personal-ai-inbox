[Unit]
Description=AI News Miniflux reader
After=ai-news-postgres.service
ConditionPathExists=/home/ubuntu/ai-news/.private/miniflux.env
[Service]
Type=simple
WorkingDirectory=/home/ubuntu/ai-news
ExecStart=/home/ubuntu/ai-news/runtime/miniflux
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/ai-news/.private/miniflux.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
[Install]
WantedBy=default.target
