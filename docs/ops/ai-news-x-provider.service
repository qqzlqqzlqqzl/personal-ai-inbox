[Unit]
Description=Personal AI Inbox X guest provider
Wants=ai-news-proxy.service
After=network-online.target ai-news-proxy.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/ai-news/runtime/x-cli
Environment="HTTPS_PROXY=http://127.0.0.1:17890"
Environment="HTTP_PROXY=http://127.0.0.1:17890"
ExecStart=/home/ubuntu/ai-news/runtime/x-cli/x serve --guest --addr 127.0.0.1:17910 --rate 300ms --retries 1 --limit 20 --data-dir /home/ubuntu/ai-news/state/x-cli
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
