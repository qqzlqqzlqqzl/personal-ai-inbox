[Unit]
Description=AI News isolated PostgreSQL
[Service]
Type=simple
WorkingDirectory=/home/ubuntu/ai-news
Environment=LD_LIBRARY_PATH=/home/ubuntu/ai-news/runtime/pg/usr/lib/x86_64-linux-gnu
ExecStart=/home/ubuntu/ai-news/runtime/pg/usr/lib/postgresql/16/bin/postgres -D /home/ubuntu/ai-news/state/postgres -p 55432 -c listen_addresses=127.0.0.1 -c unix_socket_directories=/home/ubuntu/ai-news/.private/pgsocket -c shared_buffers=64MB -c max_connections=20 -c jit=off
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
[Install]
WantedBy=default.target
