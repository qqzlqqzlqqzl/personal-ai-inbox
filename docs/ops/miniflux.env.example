ADMIN_USERNAME=qqzl
ADMIN_PASSWORD=CHOOSE_A_NEW_STRONG_PASSWORD
CREATE_ADMIN=1
RUN_MIGRATIONS=1
BASE_URL=http://127.0.0.1:8092/mf
LISTEN_ADDR=127.0.0.1:8091
WORKER_POOL_SIZE=2
