[Unit]
Description=AI News private web gateway
[Service]
Type=simple
WorkingDirectory=/home/ubuntu/ai-news/src
ExecStart=/home/ubuntu/ai-news/runtime/venv/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8092 --no-access-log
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/ai-news/.private/ai.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
[Install]
WantedBy=default.target
