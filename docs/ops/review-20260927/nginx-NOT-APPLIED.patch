--- /etc/nginx/snippets/personal-security-headers.conf
+++ /etc/nginx/snippets/personal-security-headers.conf
@@ -0,0 +1,4 @@
+add_header X-Content-Type-Options nosniff always;
+add_header X-Frame-Options SAMEORIGIN always;
+add_header Referrer-Policy no-referrer always;
+add_header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
--- /etc/nginx/conf.d/01-personal-hardening.conf
+++ /etc/nginx/conf.d/01-personal-hardening.conf
@@ -0,0 +1,2 @@
+log_format personal_safe '$remote_addr $time_iso8601 "$request_method $uri $server_protocol" $status $body_bytes_sent rt=$request_time';
+limit_req_zone $binary_remote_addr zone=personal_auth:1m rate=10r/m;
--- /etc/nginx/conf.d/toolbox-https.conf
+++ /etc/nginx/conf.d/toolbox-https.conf
@@ -5,7 +5,10 @@
     ssl_certificate /etc/letsencrypt/live/106.53.40.6/fullchain.pem;
     ssl_certificate_key /etc/letsencrypt/live/106.53.40.6/privkey.pem;
     ssl_protocols TLSv1.2 TLSv1.3;
-    client_max_body_size 64k;
+    client_max_body_size 2m;
+    access_log /var/log/nginx/access.log personal_safe;
+    include /etc/nginx/snippets/personal-security-headers.conf;
+    proxy_cookie_flags ~ secure httponly samesite=lax;
     location = /api/login {
         limit_req zone=toolbox_login burst=10 nodelay;
         limit_req_status 429;
--- /etc/nginx/toolbox/inbox.conf
+++ /etc/nginx/toolbox/inbox.conf
@@ -7,7 +7,7 @@
     proxy_http_version 1.1;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
-    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-For $remote_addr;
     proxy_set_header X-Forwarded-Proto https;
     proxy_read_timeout 90s;
 }
@@ -17,7 +17,7 @@
     proxy_http_version 1.1;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
-    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-For $remote_addr;
     proxy_set_header X-Forwarded-Proto https;
     proxy_read_timeout 90s;
 }
--- /etc/nginx/toolbox/newapi.conf
+++ /etc/nginx/toolbox/newapi.conf
@@ -1,3 +1,14 @@
+location = /api/user/login {
+    limit_req zone=personal_auth burst=10 nodelay;
+    limit_req_status 429;
+    client_max_body_size 64k;
+    proxy_pass http://127.0.0.1:18767;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $remote_addr;
+    proxy_set_header X-Forwarded-Proto https;
+}
 # New API upstream UI and dashboard APIs, sharing the existing IP certificate.
 location = /newapi { return 302 /dashboard/; }
 location = /newapi/ { return 302 /dashboard/; }
