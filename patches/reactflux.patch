+<script>
+(() => {
+  const panel = document.getElementById('inbox-load-error');
+  const message = document.getElementById('inbox-load-message');
+  const detail = document.getElementById('inbox-load-detail');
+  let ready = false;
+  let hardFailure = false;
+  const show = (text, path = '', hard = true) => {
+    hardFailure = hardFailure || hard;
+    message.textContent = text;
+    detail.textContent = path;
+    panel.hidden = false;
+  };
+  window.inboxShowLoadError = show;
+  document.getElementById('inbox-load-retry').onclick = () => location.reload();
+  window.addEventListener('error', (event) => {
+    const target = event.target;
+    if (target && target.tagName === 'SCRIPT' && target.src) {
+      show('页面脚本加载失败，可能是文件缺失或网络连接中断。', target.src);
+      const controller = new AbortController();
+      const timer = setTimeout(() => controller.abort(), 5000);
+      fetch(target.src, {method:'HEAD', cache:'no-store', signal:controller.signal})
+        .then(response => {
+          if (!response.ok) show('页面资源加载失败（HTTP ' + response.status + '）。请刷新重试；若仍失败，需要修复服务器资源。', target.src);
+        }).catch(() => {}).finally(() => clearTimeout(timer));
+    } else if (!ready && event.message) {
+      show('页面启动失败，请刷新重试。', event.message);
+    }
+  }, true);
+  window.addEventListener('vite:preloadError', () => show('页面更新后的资源加载失败，请重新加载。'));
+  const root = document.getElementById('root');
+  const observer = new MutationObserver(() => {
+    if (root.textContent.trim()) {
+      ready = true;
+      if (!hardFailure) panel.hidden = true;
+      observer.disconnect();
+    }
+  });
+  observer.observe(root, {childList:true, subtree:true, characterData:true});
+  setTimeout(() => {
+    if (!ready && !hardFailure) show('页面加载时间较长，请检查网络连接，或重新加载。', '', false);
+  }, 15000);
+})();
+</script>
+<!-- inbox-boot-guard:end -->
