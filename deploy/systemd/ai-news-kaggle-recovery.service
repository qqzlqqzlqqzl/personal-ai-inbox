[Unit]
Description=Personal Inbox single Kaggle scheduler and recovery
Wants=ai-news-miniflux.service
After=ai-news-miniflux.service ai-news-postgres.service
StartLimitIntervalSec=180
StartLimitBurst=3
[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/ai-news
ExecStart=/home/ubuntu/ai-news/runtime/venv/bin/python /home/ubuntu/ai-news/src/kaggle_batch/recovery_watchdog.py
TimeoutStartSec=120
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
