[Unit]
Description=Refresh due Python vendor RSS adapters
After=ai-news-proxy.service
[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/ai-news
Environment=PYTHONUNBUFFERED=1
Environment=VENDOR_OUTBOUND_PROXY=http://127.0.0.1:17890
ExecStart=/home/ubuntu/ai-news/runtime/venv/bin/python /home/ubuntu/ai-news/src/vendor_sources.py --refresh
TimeoutStartSec=20min
MemoryMax=384M
UMask=0077
NoNewPrivileges=true
